
# ============================================================
# QIFY Virtual Drive — Git Ignore Rules
# ============================================================

# ---------- Python bytecode ----------
__pycache__/
*.py[cod]
*$py.class
*.so

# ---------- Virtual environments ----------
.venv/
.venv*/
venv/
env/
ENV/
env.bak/
venv.bak/

# ---------- Environment variables and secrets ----------
.env
.env.*
!.env.example
.pypirc

# Google OAuth credentials and tokens
credentials.json
client_secret*.json
token*.json
*token*.json

# Local application configuration and private settings
config/
secrets/
*.pem
*.key

# ---------- Local databases and application state ----------
*.sqlite
*.sqlite3
*.db
*.db-journal
db.sqlite3
db.sqlite3-journal

# ---------- Caches and temporary files ----------
.cache/
cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.dmypy.json
.pyre/
.pytype/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
.cover/
*.log
logs/
temp/
tmp/
tempCodeRunnerFile.py

# ---------- Testing and coverage reports ----------
coverage.xml
nosetests.xml
*.cover
*.py.cover
*.lcov
test-results/
junit.xml

# ---------- Packaging and distribution ----------
build/
dist/
downloads/
develop-eggs/
eggs/
.eggs/
parts/
sdist/
wheels/
share/python-wheels/
lib/
lib64/
*.egg
*.egg-info/
.installed.cfg
MANIFEST
.Python

# ---------- PyInstaller ----------
*.manifest
*.spec

# ---------- Windows build artifacts ----------
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.msi
*.msix
*.msixbundle
*.appx
*.appxbundle

# Keep installer binaries out of Git unless deliberately
# published as GitHub Release assets.
QIFY-Virtual-Drive-Setup.exe
QIFY-Virtual-Drive-*.exe

# ---------- IDEs and editors ----------
.vscode/
.idea/
.spyderproject
.spyproject
.ropeproject
*.code-workspace

# ---------- Operating system files ----------
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100/
.Trashes/

# ---------- Documentation build output ----------
docs/_build/
site/

# ---------- Jupyter ----------
.ipynb_checkpoints/
profile_default/
ipython_config.py

# ---------- Other Python tooling ----------
.pybuilder/
.pytype/
cython_debug/
__pypackages__/
.pdm-python
.pdm-build/
.pixi/
.mypy_cache/

# ---------- Other local tooling ----------
.streamlit/secrets.toml
.webassets-cache/
.scrapy/
.abstra/
celerybeat-schedule*
celerybeat.pid
*.pid
*.rdb
*.aof

# ---------- QIFY Virtual Drive local runtime data ----------
# Never commit downloaded file caches or local logs.
file_cache/
download_cache/
runtime/
state/
*.part
*.tmp
*.temp

# ---------- Explicitly keep useful examples ----------
!.env.example
